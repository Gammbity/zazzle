# Server-side only — how THIS container reaches Django. In docker-compose,
# use the service name (http://backend:8000); locally, http://localhost:8000.
BACKEND_URL=http://localhost:8000

# Client-side (exposed to the browser) — must be reachable from the host.
NUXT_PUBLIC_MEDIA_URL=http://localhost:8000/media
NUXT_PUBLIC_STATIC_URL=http://localhost:8000/static
NUXT_PUBLIC_SITE_URL=http://localhost:3000
